{
  "name": "youtube-client-mcp",
  "version": "1.1.0",
  "description": "YouTube Client — Node library and MCP server for transcripts, RAG citation packs, video Q&A, playlist/channel batches, chapters, captions, and search. Native Go engine. No yt-dlp. No Python.",
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./mcp": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "youtube-client": "dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist bin",
    "build:ts": "tsc -p tsconfig.json",
    "build:go": "node scripts/build-go.mjs",
    "build": "npm run build:ts && npm run build:go",
    "test:go": "go test ./...",
    "test": "npm run build:ts && npm run test:go",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm test && npm run build:go"
  },
  "keywords": [
    "youtube-client",
    "youtube",
    "youtube-mcp",
    "mcp",
    "model-context-protocol",
    "cursor-mcp",
    "claude-mcp",
    "youtube-transcript",
    "youtube-captions",
    "youtube-subtitles",
    "youtube-chapters",
    "youtube-summarizer",
    "youtube-playlist",
    "video-qa",
    "rag",
    "transcript",
    "captions",
    "subtitles",
    "innertube",
    "ai-agent",
    "llm",
    "typescript",
    "nodejs",
    "golang",
    "yt-dlp-alternative",
    "youtube-api",
    "video-analysis"
  ],
  "author": "ak3ilb",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ak3ilb/youtube.git"
  },
  "bugs": {
    "url": "https://github.com/ak3ilb/youtube/issues"
  },
  "homepage": "https://github.com/ak3ilb/youtube#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
