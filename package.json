{
  "name": "youtube-client-mcp",
  "version": "2.4.0",
  "description": "YouTube Client — pure Node.js library and MCP server for reliable transcripts (Shorts + long videos), RAG citation packs, video Q&A, playlist/channel batches, chapters, captions, and search. No Go. No yt-dlp. No Python.",
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./mcp": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "youtube-client": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "build:ts": "tsc -p tsconfig.json",
    "test:unit": "tsx --test src/engine/*.test.ts",
    "test": "npm run build && npm run test:unit",
    "smoke": "node scripts/smoke.mjs",
    "verify:browser": "npm run build && node scripts/browser-transcript-verify.mjs",
    "verify:browser-batch": "npm run build && node scripts/browser-batch-verify.mjs",
    "channel:export": "npm run build && node scripts/channel-export.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "youtube-client",
    "youtube",
    "youtube-mcp",
    "mcp",
    "model-context-protocol",
    "cursor-mcp",
    "claude-mcp",
    "youtube-transcript",
    "youtube-captions",
    "youtube-subtitles",
    "youtube-chapters",
    "youtube-summarizer",
    "youtube-playlist",
    "video-qa",
    "rag",
    "transcript",
    "captions",
    "subtitles",
    "innertube",
    "ai-agent",
    "llm",
    "typescript",
    "nodejs",
    "yt-dlp-alternative",
    "youtube-api",
    "video-analysis"
  ],
  "author": "ak3ilb",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ak3ilb/youtube.git"
  },
  "bugs": {
    "url": "https://github.com/ak3ilb/youtube/issues"
  },
  "homepage": "https://github.com/ak3ilb/youtube#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  }
}
